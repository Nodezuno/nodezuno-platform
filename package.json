{
  "name": "nodezuno-website",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:cloudflare": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:sites": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "preflight:cloudflare": "node scripts/cloudflare-release.mjs preflight",
    "bootstrap:cloudflare": "node scripts/cloudflare-release.mjs bootstrap",
    "deploy:cloudflare": "node scripts/cloudflare-release.mjs deploy",
    "build:container": "NEXT_TELEMETRY_DISABLED=1 NODEZUNO_RUNTIME=container next build --webpack",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "start:container": "NODEZUNO_RUNTIME=container node .next/standalone/server.js",
    "test": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build && node scripts/run-node-tests.mjs",
    "test:discovery": "node scripts/run-node-tests.mjs --discovery-only",
    "test:container": "node scripts/run-node-tests.mjs --prefix=container- --allow-partial",
    "test:container:integration": "NODEZUNO_D1_INTEGRATION=true node scripts/run-node-tests.mjs --exact=container-d1-integration.test.mjs --allow-partial",
    "smoke:local": "node scripts/backend-smoke.mjs http://localhost:3000",
    "smoke:auth": "node scripts/auth-provider-smoke.mjs",
    "verify:cloudflare-artifact": "node scripts/verify-cloudflare-artifact.mjs",
    "smoke:links": "node scripts/check-public-links.mjs",
    "smoke:external-links": "node scripts/check-external-links.mjs",
    "preflight:application": "node scripts/preflight-review-application.mjs",
    "release:source:verify": "node scripts/verify-source-integrity.mjs",
    "release:source:export": "node scripts/export-source.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "node scripts/block-drizzle-generation.mjs",
    "db:migrate:local": "wrangler d1 migrations apply nodezuno-production --local --persist-to .wrangler/state --config wrangler.local.jsonc",
    "db:migrate:cloudflare": "wrangler d1 migrations apply nodezuno-production --remote --config wrangler.jsonc",
    "db:migrate:container": "node scripts/migrate-container.mjs",
    "db:backup:sqlite": "node scripts/backup-sqlite.mjs",
    "db:restore:sqlite": "node scripts/restore-sqlite.mjs",
    "outbox:process": "node scripts/process-notification-outbox.mjs --once",
    "payments:preflight": "node scripts/preflight-stablecoin-payments.mjs",
    "payments:process": "node scripts/process-stablecoin-payments.mjs --once",
    "local-mac:toolchain": "bash deploy/local-mac/bootstrap-toolchain.sh",
    "local-mac:install": "bash deploy/local-mac/install.sh",
    "local-mac:deploy": "bash deploy/local-mac/deploy.sh",
    "local-mac:start": "bash deploy/local-mac/start.sh",
    "local-mac:stop": "bash deploy/local-mac/stop.sh",
    "local-mac:status": "bash deploy/local-mac/status.sh",
    "local-mac:health": "bash deploy/local-mac/health.sh",
    "local-mac:logs": "bash deploy/local-mac/logs.sh",
    "local-mac:backup": "bash deploy/local-mac/backup.sh"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@solana/wallet-standard-features": "1.4.0",
    "@solana/wallet-standard-util": "1.1.3",
    "@wallet-standard/app": "1.1.1",
    "@wallet-standard/base": "1.1.1",
    "@wallet-standard/features": "1.1.1",
    "better-auth": "1.7.25",
    "bs58": "6.0.0",
    "drizzle-orm": "0.45.4",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "viem": "2.55.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.70.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.6",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.3.8",
    "wrangler": "4.163.0"
  },
  "type": "module"
}
