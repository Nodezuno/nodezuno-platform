NODEZUNO_RUNTIME=container
NODEZUNO_LOCAL_PREVIEW=true
# Keep false until the launch checklist in docs/AWS_DEPLOYMENT.md has written
# legal and commerce approval. Payments and public indexing fail closed.
NODEZUNO_LEGAL_LAUNCH_APPROVED=false
# Keep false for private previews. Set true only for a reviewed public launch.
NODEZUNO_PUBLIC_INDEXING=false
NODEZUNO_ALLOW_SCHEMA_BASELINE=false
NODEZUNO_ALLOW_CONTRACT_MIGRATIONS=false
NODEZUNO_DOMAIN=localhost
PUBLIC_ORIGIN=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
# Use direct when the cloud provider or your own TLS reverse proxy sends
# requests straight to this container. Use trusted-gateway only when a
# separately managed gateway injects NODEZUNO_ORIGIN_SECRET on every request.
NODEZUNO_INGRESS_MODE=direct

# The default low-cost, single-instance profile uses SQLite on a persistent
# volume. Use d1-rest instead only when a reviewed Cloudflare D1 database is
# intentionally shared by more than one stateless web instance.
NODEZUNO_DATABASE_DRIVER=sqlite
NODEZUNO_SQLITE_PATH=/var/lib/nodezuno/nodezuno.sqlite

RATE_LIMIT_SECRET=replace-with-at-least-32-random-characters
API_KEY_PEPPER=replace-with-an-independent-32-character-secret
BETTER_AUTH_SECRET=replace-with-an-independent-32-byte-random-secret
# Durable key for private review links. Keep independent and backed up.
REVIEW_CAPABILITY_SECRET=replace-with-a-fourth-independent-32-byte-random-secret
# Required only for NODEZUNO_INGRESS_MODE=trusted-gateway. Leave it completely
# blank in direct mode.
NODEZUNO_ORIGIN_SECRET=
NODEZUNO_ADMIN_EMAILS=info@nodezuno.com

# Optional. Configure both to enable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Zoho SMTP sender is fixed to info@nodezuno.com and uses TLS on port 465.
ZOHO_SMTP_HOST=smtp.zoho.in
# Set this through a secret manager or ignored local environment file.
ZOHO_SMTP_PASSWORD=

# The Ethereum verifier below is the only customer payment path.
NODEZUNO_STABLECOIN_PAYMENT_MODE=disabled
NODEZUNO_ETHEREUM_RPC_ENDPOINTS_JSON=
NODEZUNO_PAYMENT_CONFIRMATIONS=12
NODEZUNO_DELIVERABLE_BUCKET=
NODEZUNO_DELIVERABLE_KMS_KEY_ARN=

# Optional. Leave blank to keep Ethereum, Base, and Solana RPC services
# configuration-only. Add only the networks attached to this deployment.
# Secret JSON shape:
# {"ethereum":[{"name":"eth-primary","url":"https://<ethereum-upstream>","timeoutMs":8000,"headers":{"Authorization":"Bearer <provider-secret>"}}],"base":[{"name":"base-primary","url":"https://<base-upstream>","timeoutMs":8000,"headers":{}}],"solana":[{"name":"solana-primary","url":"https://<solana-upstream>","timeoutMs":8000,"headers":{}}]}
NODEZUNO_RPC_UPSTREAMS_JSON=
# Disabled by default. Set true only when an Ethereum client is bound to
# 127.0.0.1 on this same container host. The exception accepts only an
# uncredentialed root URL with an explicit unprivileged port.
NODEZUNO_ALLOW_ETHEREUM_HTTP_LOOPBACK=false
# Quotas use method-weighted units. Ordinary calls cost 1. Expensive EVM and
# Solana reads cost 3, 5, or 10 according to the documented method schedule.
# A batch consumes the sum of its executable calls. The first quota is per
# service and API key; the second is workspace-wide across every service and key.
NODEZUNO_RPC_HOURLY_CALL_QUOTA=1000
NODEZUNO_RPC_WORKSPACE_HOURLY_CALL_QUOTA=10000

# Optional until the native gRPC gateway is deployed. Configure both values to
# activate native gRPC services after the gateway health probe succeeds.
NODEZUNO_GRPC_PUBLIC_ENDPOINT=
NODEZUNO_GRPC_AUTH_SECRET=

# Required only when NODEZUNO_DATABASE_DRIVER=d1-rest.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_D1_API_TOKEN=

# Optional Cloudflare Access administrator identity overlay. Allowlisted
# application accounts work without this pair. Configure both values or
# neither.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUDIENCE=
