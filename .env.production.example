# Copy to a private local file, set mode 0600, replace every placeholder, and
# upload it with deploy/aws/scripts/upload-production-environment.sh. Never
# commit the populated file or print it in a terminal.
NODEZUNO_DOMAIN=nodezuno.com
CADDY_ACME_EMAIL=info@nodezuno.com
PUBLIC_ORIGIN=https://nodezuno.com
BETTER_AUTH_URL=https://nodezuno.com

# Generate each value independently with: openssl rand -hex 32
RATE_LIMIT_SECRET=replace-with-independent-random-value
API_KEY_PEPPER=replace-with-different-independent-random-value
BETTER_AUTH_SECRET=replace-with-third-independent-random-value
REVIEW_CAPABILITY_SECRET=replace-with-fourth-independent-random-value

NODEZUNO_ADMIN_EMAILS=info@nodezuno.com
NODEZUNO_ENABLE_LEGACY_HOSTING_IDENTITY=false
NODEZUNO_LEGAL_LAUNCH_APPROVED=false
NODEZUNO_PUBLIC_INDEXING=false
NODEZUNO_ALLOW_SCHEMA_BASELINE=false
NODEZUNO_ALLOW_CONTRACT_MIGRATIONS=false

# Zoho account host may vary by region. Confirm this host in Zoho Mail settings.
ZOHO_SMTP_HOST=smtp.zoho.in
# Store the Zoho app password only in the deployment secret manager.
ZOHO_SMTP_PASSWORD=replace-with-zoho-app-password

# Direct stablecoin transfers are verified from Ethereum mainnet evidence.
# The website never holds a private key. Keep disabled until the blocking legal
# and commerce gate in docs/AWS_DEPLOYMENT.md is complete.
NODEZUNO_STABLECOIN_PAYMENT_MODE=disabled
# Before changing the payment mode, attach at least two independently operated,
# fully synchronized endpoints that support the finalized block tag. One
# endpoint alone cannot enable payments.
NODEZUNO_ETHEREUM_RPC_ENDPOINTS_JSON=
NODEZUNO_PAYMENT_CONFIRMATIONS=12
AWS_REGION=ap-south-1
NODEZUNO_DELIVERABLE_BUCKET=replace-with-private-deliverables-bucket
NODEZUNO_DELIVERABLE_KMS_KEY_ARN=arn:aws:kms:ap-south-1:000000000000:key/00000000-0000-4000-8000-000000000000

# Optional Google authentication. Configure both or leave both blank.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The public Upgrade Assurance offer does not require blockchain upstreams.
NODEZUNO_RPC_UPSTREAMS_JSON=
NODEZUNO_GRPC_PUBLIC_ENDPOINT=
NODEZUNO_GRPC_AUTH_SECRET=
