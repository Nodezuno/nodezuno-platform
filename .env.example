# Generate a cryptographically random value of at least 32 characters.
RATE_LIMIT_SECRET=replace-with-a-strong-local-secret

# Keep this independent from RATE_LIMIT_SECRET. Rotating it invalidates keys.
API_KEY_PEPPER=replace-with-an-independent-strong-local-secret

# Session encryption and origin binding for customer accounts.
BETTER_AUTH_SECRET=replace-with-an-independent-32-byte-random-secret
# Durable key for private review links. Keep independent and backed up.
REVIEW_CAPABILITY_SECRET=replace-with-a-fourth-independent-32-byte-random-secret
NODEZUNO_DOMAIN=localhost
BETTER_AUTH_URL=http://localhost:3000

# Optional. Google remains visibly unavailable until both values are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Zoho SMTP uses implicit TLS on port 465. Keep the mailbox password in a
# secret store or ignored .dev.vars file, never in source control.
ZOHO_SMTP_HOST=smtp.zoho.in
ZOHO_SMTP_PASSWORD=

# Direct self-custody settlement. The recipient is fixed in server code as
# 0x07218C8E2B01fbff950Af65A0f36D3305520aC3b. No private key is used here.
NODEZUNO_STABLECOIN_PAYMENT_MODE=disabled
# Two or three independent Ethereum mainnet RPC endpoints. HTTPS is required
# except for a private or loopback HTTP node. Never expose this value publicly.
# [{"name":"payment-mainnet-primary","provider":"primary-provider","url":"https://your-primary-synced-node.example/rpc","headers":{},"timeoutMs":8000},{"name":"payment-mainnet-secondary","provider":"secondary-provider","url":"https://your-secondary-synced-node.example/rpc","headers":{},"timeoutMs":8000}]
NODEZUNO_ETHEREUM_RPC_ENDPOINTS_JSON=
NODEZUNO_PAYMENT_CONFIRMATIONS=12
# Comma-separated verified emails allowed to use /admin and /api/v1/admin/*.
NODEZUNO_ADMIN_EMAILS=info@nodezuno.com
NODEZUNO_ENABLE_LEGACY_HOSTING_IDENTITY=false
# Keep false until the launch checklist in docs/AWS_DEPLOYMENT.md has written
# legal and commerce approval. Payments and public indexing fail closed.
NODEZUNO_LEGAL_LAUNCH_APPROVED=false
# Keep false for private previews. Set true only for a reviewed public launch.
NODEZUNO_PUBLIC_INDEXING=false

# Optional. Leave blank to keep Ethereum, Base, and Solana RPC services
# configuration-only. Add only the networks attached to this deployment.
# Secret JSON shape:
# {"ethereum":[{"name":"eth-primary","url":"https://<ethereum-upstream>","timeoutMs":8000,"headers":{"Authorization":"Bearer <provider-secret>"}}],"base":[{"name":"base-primary","url":"https://<base-upstream>","timeoutMs":8000,"headers":{}}],"solana":[{"name":"solana-primary","url":"https://<solana-upstream>","timeoutMs":8000,"headers":{}}]}
NODEZUNO_RPC_UPSTREAMS_JSON=

# Quotas use method-weighted units. Ordinary calls cost 1. Expensive EVM and
# Solana reads cost 3, 5, or 10 according to the documented method schedule.
# A batch consumes the sum of its executable calls. The first quota is per
# service and API key; the second is workspace-wide across every service and key.
NODEZUNO_RPC_HOURLY_CALL_QUOTA=1000
NODEZUNO_RPC_WORKSPACE_HOURLY_CALL_QUOTA=10000

# Optional until the native gRPC gateway is deployed. Configure both values to
# activate native gRPC services after the gateway health probe succeeds. The
# secret must match the gateway NODEZUNO_GRPC_AUTH_SECRET and must be distinct
# from every other application secret.
NODEZUNO_GRPC_PUBLIC_ENDPOINT=
NODEZUNO_GRPC_AUTH_SECRET=
