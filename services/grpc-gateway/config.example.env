# Preferred production contract. Supply an ordered JSON array with one to four
# isolated providers. Every entry requires a unique lowercase name, an HTTPS
# URL, a timeout between 100ms and 30s, and a headers object. Keep credentials
# in the deployment secret manager. Example:
# [{"name":"primary","url":"https://primary.example/rpc","timeout":"3s","headers":{}},{"name":"secondary","url":"https://secondary.example/rpc","timeout":"3s","headers":{"Authorization":"Bearer provider-token"}}]
ETHEREUM_UPSTREAMS_JSON=

# Compatibility path for one upstream. Leave both values empty when
# ETHEREUM_UPSTREAMS_JSON is configured. HTTPS is mandatory unless this process
# and the node communicate over a protected private network and
# GRPC_ALLOW_INSECURE_UPSTREAM is explicitly true.
ETHEREUM_RPC_URL=

# Optional compatibility-path credentials sent only to that upstream. Example:
# {"Authorization":"Bearer provider-token","X-API-Key":"provider-api-key"}
ETHEREUM_RPC_HEADERS_JSON=

# Production mode. The website control plane validates the same service-bound
# keys customers create in the Nodezuno console. Use the exact public HTTPS
# authorization route. Keep this secret distinct from every website secret.
NODEZUNO_GRPC_AUTH_MODE=control-plane
NODEZUNO_GRPC_AUTH_URL=https://nodezuno.com/api/v1/internal/grpc/authorize
NODEZUNO_GRPC_AUTH_SECRET=
NODEZUNO_GRPC_AUTH_TIMEOUT=2s

# Leave this empty in control-plane mode. For an isolated local or emergency
# static-digest deployment, set NODEZUNO_GRPC_AUTH_MODE=static-digest, clear
# the three control-plane values above, and provide one or more comma-separated
# SHA-256 key digests here. Static keys are not managed by the customer console.
GRPC_API_KEY_SHA256=

# Safe read-oriented defaults are built in. Set this value to replace them.
ETHEREUM_ALLOWED_METHODS=eth_chainId,eth_blockNumber,eth_getBalance,eth_getCode,eth_call,eth_estimateGas,eth_gasPrice,eth_maxPriorityFeePerGas,eth_feeHistory,eth_getTransactionByHash,eth_getTransactionReceipt,eth_getBlockByHash,eth_getBlockByNumber,net_version,web3_clientVersion

# Cloud Run supplies PORT. GRPC_LISTEN_ADDR takes precedence when both exist.
GRPC_LISTEN_ADDR=:50051
GRPC_UPSTREAM_TIMEOUT=12s
GRPC_SHUTDOWN_TIMEOUT=20s
GRPC_MAX_REQUEST_BYTES=1048576
GRPC_MAX_RESPONSE_BYTES=4194304
GRPC_MAX_CONCURRENT_CALLS=128
GRPC_ALLOW_INSECURE_UPSTREAM=false

# Leave both empty behind a trusted HTTP/2 TLS terminator. Configure both only
# when this process terminates TLS itself.
GRPC_TLS_CERT_FILE=
GRPC_TLS_KEY_FILE=

LOG_LEVEL=info
